rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == "wiaeztytR3NOTnERIaXRGBzo6eM2";
    }

    match /scheduleDays/{date} {
      allow read, write: if isOwner();
    }

    match /bloqueios/{blockId} {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.data.keys().hasAll(["date", "start", "end", "type"])
        && request.resource.data.keys().hasOnly(["date", "start", "end", "type", "createdAt"])
        && request.resource.data.date is string
        && request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.start is string
        && request.resource.data.start.matches("^(0[8-9]|1[0-9]|2[0-1]):[0-5][0-9]$")
        && request.resource.data.end is string
        && request.resource.data.end.matches("^(0[8-9]|1[0-9]|2[0-1]):[0-5][0-9]$|^22:00$")
        && request.resource.data.end > request.resource.data.start
        && request.resource.data.type in ["manual", "appointment"];
      allow delete: if isOwner();
    }

    match /availability/{slotId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll([
          "name", "phone", "style", "location", "size", "description",
          "date", "start", "slotId", "status", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "name", "phone", "style", "location", "size", "description",
          "date", "start", "slotId", "status", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 30
        && request.resource.data.phone.matches("^[0-9+() .-]{10,30}$")
        && request.resource.data.style is string
        && request.resource.data.style.size() <= 100
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 100
        && request.resource.data.size is string
        && request.resource.data.size.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.date is string
        && request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.start is string
        && request.resource.data.start.matches("^(08|09|1[0-9]|2[0-1]):00$")
        && request.resource.data.slotId is string
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time;

      allow get, list, update, delete: if isOwner();
    }

    match /appointments/{appointmentId} {
      allow read, write: if isOwner();
    }
  }
}
